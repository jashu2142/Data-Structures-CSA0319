#include <stdio.h>

#define INF 9999
#define MAX 10

void dijkstra(int a[MAX][MAX], int n, int start) {
    int dist[MAX], visited[MAX];
    int i, j, count, u, v;

    for (i = 0; i < n; i++) {
        dist[i] = a[start][i];
        visited[i] = 0;
    }

    dist[start] = 0;
    visited[start] = 1;

    for (count = 1; count < n - 1; count++) {
        int min = INF;
        
        for (i = 0; i < n; i++)
            if (!visited[i] && dist[i] < min) {
                min = dist[i];
                u = i;
            }

        visited[u] = 1;

        for (v = 0; v < n; v++)
            if (!visited[v] && dist[u] + a[u][v] < dist[v])
                dist[v] = dist[u] + a[u][v];
    }

    printf("\nShortest distances from node %d:\n", start);
    for (i = 0; i < n; i++)
        printf("To %d = %d\n", i, dist[i]);
}

int main() {
    int n, a[MAX][MAX], i, j, start;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix (9999 for no edge):\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &a[i][j]);

    printf("Enter starting vertex: ");
    scanf("%d", &start);

    dijkstra(a, n, start);

    return 0;
}
