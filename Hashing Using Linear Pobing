#include <stdio.h>

#define SIZE 10   // Size of hash table

int hashTable[SIZE];

// Initialize hash table with -1 (empty)
void init() {
    for (int i = 0; i < SIZE; i++)
        hashTable[i] = -1;
}

// Insert using Linear Probing
void insert(int key) {
    int index = key % SIZE;

    if (hashTable[index] == -1) {
        hashTable[index] = key;
    } else {
        // Linear Probing
        int i = (index + 1) % SIZE;
        while (i != index && hashTable[i] != -1) {
            i = (i + 1) % SIZE;
        }

        if (i == index) {
            printf("Hash Table is full\n");
            return;
        }

        hashTable[i] = key;
    }
}

// Display hash table
void display() {
    printf("\nHash Table:\n");
    for (int i = 0; i < SIZE; i++) {
        printf("Index %d : %d\n", i, hashTable[i]);
    }
}

int main() {
    init();

    insert(5);
    insert(15);
    insert(25);
    insert(35);
    insert(22);

    display();

    return 0;
}
