#include <stdio.h>

void DFS(int a[10][10], int n, int start, int visited[]) {
    printf("%d ", start);
    visited[start] = 1;

    for (int i = 0; i < n; i++) {
        if (a[start][i] == 1 && visited[i] == 0) {
            DFS(a, n, i, visited);
        }
    }
}

int main() {
    int n, a[10][10], start;
    int visited[10] = {0};

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            scanf("%d", &a[i][j]);

    printf("Enter starting vertex: ");
    scanf("%d", &start);

    printf("DFS Traversal: ");
    DFS(a, n, start, visited);

    return 0;
}
