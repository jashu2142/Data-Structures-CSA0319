#include <stdio.h>

int main() {
    int arr[100], n, choice, pos, value, i;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements:\n", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    while (1) {
        printf("\n--- Array Operations ---\n");
        printf("1. Insert\n");
        printf("2. Delete\n");
        printf("3. Display\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {

        case 1: // Insert
            printf("Enter position to insert (0 to %d): ", n);
            scanf("%d", &pos);
            printf("Enter value to insert: ");
            scanf("%d", &value);

            for (i = n; i > pos; i--) {
                arr[i] = arr[i - 1];
            }
            arr[pos] = value;
            n++;
            printf("Element inserted.\n");
            break;

        case 2: // Delete
            printf("Enter position to delete (0 to %d): ", n - 1);
            scanf("%d", &pos);

            for (i = pos; i < n - 1; i++) {
                arr[i] = arr[i + 1];
            }
            n--;
            printf("Element deleted.\n");
            break;

        case 3: // Display
            printf("Array elements: ");
            for (i = 0; i < n; i++) {
                printf("%d ", arr[i]);
            }
            printf("\n");
            break;

        case 4:
            return 0;

        default:
            printf("Invalid choice!\n");
        }
    }

    return 0;
}
